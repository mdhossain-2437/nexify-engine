# Copy this file to .env.docker and fill in the values before running docker-compose.
# Usage: docker compose --env-file .env.docker up

POSTGRES_DB=nexify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
PAYLOAD_SECRET=your-payload-secret-min-32-chars-long-here

# Meilisearch (product search engine)
MEILISEARCH_API_KEY=your-meilisearch-master-key-here

# Redis (caching layer)
REDIS_URL=redis://redis:6379

# Stripe (subscription billing — optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_BASIC_MONTHLY_PRICE_ID=price_xxx
STRIPE_BASIC_YEARLY_PRICE_ID=price_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxx
